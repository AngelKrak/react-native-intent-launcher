  "bugs": {
    "url": "https://github.com/AngelKrak/react-native-intent-launcher/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://github.com/AngelKrak/react-native-intent-launcher#readme",
  "peerDependencies": {
    "react-native": "*"
  },
  "devDependencies": {
    "typescript": "5.9.2"
  }
